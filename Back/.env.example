# Postgres (Neon). Copiar el connection string desde el dashboard de Neon.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secreto para firmar los JWT. Generar uno con: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN_SECONDS=43200

# Cloudinary (dashboard > Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Origenes permitidos para CORS, separados por coma
CORS_ORIGINS="http://localhost:3000"

PORT=3001
